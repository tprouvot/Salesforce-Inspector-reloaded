{
  "name": "salesforce-inspector",
  "version": "2.1.0",
  "scripts": {
    "eslint": "eslint .",
    "sync-vendors": "node scripts/sync-vendors.js",
    "firefox-release-build": "node scripts/release-build.js firefox",
    "chrome-release-build": "node scripts/release-build.js chrome",
    "build-flow-scanner": "node scripts/build-flow-scanner.js",
    "set-test-constants": "node scripts/set-test-constants-from-org.js",
    "test:e2e": "playwright test",
    "test:e2e:mock": "cp tests/e2e/test-constants.template.js tests/e2e/test-constants.local.js && playwright test",
    "test:e2e:debug": "npx playwright test --ui --debug",
    "chrome-beta-build": "ENVIRONMENT_TYPE=BETA node scripts/release-build.js chrome"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.2",
    "cometd": "9.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "fs-extra": "11.2.0",
    "globals": "^17.11.0",
    "prismjs": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "replace-in-file": "8.2.0",
    "typescript": "^6.0.3",
    "zip-dir": "2.0.0"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.17"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.4"
    }
  }
}
