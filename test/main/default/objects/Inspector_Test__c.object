        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <!-- Encrypted with no Data Classification metadata so the Object Scanner "Encrypted Unclassified" rule flags it -->
        <fullName>Encrypted_SSN__c</fullName>
        <externalId>false</externalId>
        <label>Encrypted SSN</label>
        <length>20</length>
        <maskChar>asterisk</maskChar>
        <maskType>ssn</maskType>
