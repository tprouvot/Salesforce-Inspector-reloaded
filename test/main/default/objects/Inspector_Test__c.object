        <label>Email Address</label>
        <length>80</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <!-- Unrestricted, mostly-inactive picklist so the Object Scanner "Unrestricted Picklist" and "Inactive Picklist Bloat" rules flag it -->
        <fullName>Status__c</fullName>
        <externalId>false</externalId>
        <label>Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
